{
  "name": "scbe-aethermoore-cli",
  "version": "4.5.0",
  "description": "Conversation-first coding agent for terminal and browser with curated tools, persistent sessions, permissions, custom slash commands, and SCBE governance underneath.",
  "author": "Issac Daniel Davis <issdandavis@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "bin": {
    "scbe": "bin/scbe.js",
    "geoseal": "bin/geoseal.js",
    "scbe-geoseal": "bin/geoseal.js",
    "scbe-web": "bin/scbe-web.js",
    "scbe-task": "bin/scbe-task.js"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "web",
    "skills",
    "scripts/scbe_tb_agent.py",
    "scripts/shell_benchmark.cjs",
    "scripts/bench_task_corpus.cjs",
    "scripts/bench_harness_matrix.cjs",
    "scripts/bench_code_ranker.cjs",
    "scripts/bench_math_reasoning.cjs",
    "scripts/bench_tb_smoke.cjs",
    "scripts/desktop_subsystem.cjs",
    "scripts/action_runner.cjs",
    "scripts/scbe_workflow.cjs",
    "tests",
    "README.md",
    "CLI_HOST.md",
    "GUIDED_EVIDENCE_BUS.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-NOTICE.md"
  ],
  "scripts": {
    "help": "node ./bin/scbe.js --help",
    "selftest": "node ./bin/scbe.js selftest",
    "mcp": "node mcp/scbe-mcp-server.cjs",
    "test": "node --require ./tests/test-env.cjs --test --test-concurrency=1 tests/*.test.cjs",
    "bench:shell": "node scripts/shell_benchmark.cjs",
    "bench:corpus": "node scripts/bench_task_corpus.cjs",
    "bench:matrix": "node scripts/bench_harness_matrix.cjs",
    "bench:code-ranker": "node scripts/bench_code_ranker.cjs",
    "bench:math": "node scripts/bench_math_reasoning.cjs",
    "bench:tb-smoke": "node scripts/bench_tb_smoke.cjs",
    "desktop": "node scripts/desktop_subsystem.cjs",
    "actions": "node scripts/action_runner.cjs",
    "workflow": "node scripts/scbe_workflow.cjs",
    "release:gate": "node scripts/release_gate.cjs",
    "prepublishOnly": "npm run release:gate",
    "pack:dry": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ink": "^4.4.1",
    "playwright-core": "^1.58.2",
    "react": "^18.3.1",
    "scbe-aethermoore": "^4.1.0",
    "scbe-agent-bus": ">=0.5.0 <1"
  },
  "keywords": [
    "scbe",
    "aethermoore",
    "cli",
    "geoseal",
    "tokenizer",
    "governance",
    "sacred-tongues",
    "agent-tools",
    "dimensional-analysis",
    "agent-bus",
    "workflow",
    "operator-loop",
    "agent-orchestration",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/issdandavis/SCBE-AETHERMOORE.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/issdandavis/SCBE-AETHERMOORE/issues"
  },
  "homepage": "https://github.com/issdandavis/SCBE-AETHERMOORE#readme",
  "publishConfig": {
    "access": "public"
  }
}
