  },
  "role_definitions": {
    "speaker": "Produces the current utterance.",
    "addressee": "Intended recipient of the current utterance.",
    "hearer": "Recorded as hearing; attention and comprehension are separate.",
    "listener": "Recorded as attending; agreement and understanding are separate.",
    "bystander": "Present but not addressed; may or may not hear.",
    "nonparticipant": "Outside this exchange; no implied knowledge.",
    "omniscient_narrator": "Fictional view over supplied story facts; never evidence of a participant's knowledge."
  },
  "stance_definitions": {
    "negative": "Opposed emphasis toward an explicitly named topic.",
    "neutral": "Uncommitted or balanced emphasis, not missing knowledge.",
    "positive": "Supportive emphasis toward an explicitly named topic."
  },
