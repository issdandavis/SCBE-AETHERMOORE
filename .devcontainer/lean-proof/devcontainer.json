{
  "name": "SCBE Lean proof lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "LEAN_NUM_THREADS": "2",
    "MATHLIB_NO_CACHE_ON_UPDATE": "1",
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/lean-proof/post-create.sh"
}
