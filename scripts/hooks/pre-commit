#!/usr/bin/env python3
"""Pre-commit hook: secret scan + Prettier auto-format for staged TS/TSX files.

Install:  npm run hooks:install
Manual:   python scripts/check_secrets.py
"""

import re
import subprocess
import sys
from pathlib import Path

# ── secret patterns ─────────────────────────────────────────────────────────

PATTERNS = [
    (r"sk-ant-api\S{10,}", "Anthropic API key"),
    (r"sk-proj-\S{10,}", "OpenAI API key"),
    (r"ghp_[A-Za-z0-9]{30,}", "GitHub PAT"),
    (r"gho_[A-Za-z0-9]{30,}", "GitHub OAuth"),
    (r"AKIA[A-Z0-9]{16}", "AWS Access Key"),
    (r"(?:sk|rk)_live_[A-Za-z0-9_-]{20,}", "Stripe live key"),
    (r"(?:sk|rk)_test_[A-Za-z0-9_-]{20,}", "Stripe test key"),
    (r"hf_[A-Za-z0-9]{30,}", "HuggingFace token"),
    (r"KGAT_[A-Za-z0-9]{20,}", "Kaggle token"),
    (r"xai-[A-Za-z0-9]{20,}", "xAI API key"),
    (
        r"SAM-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        "SAM.gov API key",
    ),
    (r"glpat-[A-Za-z0-9_-]{20,}", "GitLab PAT"),
    (r"eyJ[A-Za-z0-9_-]{50,}\.[A-Za-z0-9_-]{50,}", "JWT token"),
]


def staged_files() -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"], capture_output=True, text=True
    )
    return [f.strip() for f in result.stdout.splitlines() if f.strip()]


def check_secrets(files: list[str]) -> list[tuple[str, str]]:
    found = []
    for filepath in files:
        try:
            with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            for pattern, name in PATTERNS:
                for m in re.findall(pattern, content):
                    if "[SCRUBBED" not in m:
                        found.append((filepath, name))
        except FileNotFoundError:
            pass
    return found


# ── prettier auto-format ─────────────────────────────────────────────────────

TS_EXTS = {".ts", ".tsx"}
PRETTIER_BIN = Path("node_modules/prettier/bin/prettier.cjs")


def run_prettier(files: list[str]) -> bool:
    """Format staged TS/TSX files with Prettier and re-stage them. Returns True on success."""
    ts_files = [f for f in files if Path(f).suffix in TS_EXTS and Path(f).exists()]
    if not ts_files:
        return True

    if not PRETTIER_BIN.exists():
        print(
            "[pre-commit] prettier not found at node_modules/prettier/bin/prettier.cjs — skipping format step"
        )
        return True

    result = subprocess.run(
        ["node", str(PRETTIER_BIN), "--write", *ts_files],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"[pre-commit] prettier failed:\n{result.stderr}")
        return False

    # Re-stage any files prettier modified.
    changed = [f for f in ts_files if result.stdout and f in result.stdout]
    if not changed:
        # prettier doesn't always print filenames when using --write; re-stage all to be safe.
        subprocess.run(["git", "add", *ts_files], check=False)
    else:
        subprocess.run(["git", "add", *changed], check=False)

    return True


# ── python lint/format: run EXACTLY what CI runs ─────────────────────────────
#
# These four commands mirror .github/workflows. If they drift, the hook stops being
# worth anything -- you pass locally and main still goes red. tests/test_precommit_
# matches_ci.py fails the build if this list and the workflows disagree.
#
# black and flake8 deliberately cover DIFFERENT directory sets (flake8 adds hydra/),
# which is exactly the kind of detail that makes "I ran black" insufficient. Both of
# this session's red builds came from that gap: an F841 unused local, then trailing
# whitespace -- black was clean for both.
#
# Scoped to STAGED files rather than whole directories: same verdict for what you are
# about to commit, but fast enough that nobody reaches for --no-verify.
CI_BLACK = ["--target-version", "py311", "--line-length", "120"]
CI_FLAKE8 = ["--max-line-length", "120"]
CI_RUFF = ["check", "--config", "ruff.toml"]
LINTED_DIRS = ("src/", "tests/", "scripts/", "agents/", "hydra/")


def _py_targets(files: list[str]) -> list[str]:
    return [f for f in files if f.endswith(".py") and f.startswith(LINTED_DIRS) and Path(f).exists()]


def run_python_checks(files: list[str]) -> bool:
    targets = _py_targets(files)
    if not targets:
        return True

    # black is a FORMATTER: fix and re-stage rather than making a human do it by hand.
    fmt = subprocess.run([sys.executable, "-m", "black", *CI_BLACK, *targets], capture_output=True, text=True)
    if fmt.returncode != 0:
        print(f"[pre-commit] black failed:\n{fmt.stderr.strip()}")
        return False
    if "reformatted" in (fmt.stderr or ""):
        subprocess.run(["git", "add", *targets], check=False)
        print(f"[pre-commit] black reformatted {len(targets)} file(s) and re-staged them")

    # flake8 and ruff are ANALYZERS: they find real defects (unused names, undefined
    # references). Auto-"fixing" those would be guessing at intent, so they block.
    for name, cmd in (
        ("flake8", [sys.executable, "-m", "flake8", *CI_FLAKE8, *targets]),
        ("ruff", [sys.executable, "-m", "ruff", *CI_RUFF, *targets]),
    ):
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode == 0:
            continue
        out = (proc.stdout or proc.stderr or "").strip()
        if "No module named" in out:
            print(f"[pre-commit] {name} not installed — skipping (CI WILL still run it)")
            continue
        print(f"\n{'='*60}\nBLOCKED: {name} found issues CI would also reject\n{'='*60}")
        print(out[:2000])
        print(f"{'='*60}\nFix these, or commit with --no-verify if you accept a red build.")
        return False
    return True


# ── main ────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    files = staged_files()

    # 1. Format first so the secret scan sees the final content.
    if not run_prettier(files):
        sys.exit(1)

    # 1b. Python lint/format, same commands as CI.
    if not run_python_checks(staged_files()):
        sys.exit(1)

    # 2. Secret scan on (potentially re-staged) files.
    findings = check_secrets(files)
    if findings:
        print(f"\n{'='*60}")
        print(f"BLOCKED: {len(findings)} CREDENTIAL PATTERN(S) DETECTED")
        print(f"{'='*60}")
        for path, _name in findings:
            # Do NOT echo the matched value or type label here; report only the file path.
            print(f"  {path}")
        print("\nReplace credentials with [SCRUBBED:type] before committing.")
        print(f"{'='*60}")
        sys.exit(1)

    print("No secrets found. Safe to commit.")
    sys.exit(0)
